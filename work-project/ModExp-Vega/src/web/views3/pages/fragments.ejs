<div class="schema-widget" id="mainWidget">
    <header class="schema-header">
        <div class="status-block">
            <div class="status-dot"></div>
            <span class="status-text">Online</span>
        </div>

        <!-- Вибір Unit -->
        <select class="custom-select" id="select-unit">
            <!-- Цей варіант буде видимим спочатку, але його не можна обрати повторно -->
            <option value="" disabled selected>Оберіть блок...</option>

            <!-- Значення -->
            <option value="1">Блок №1</option>
            <option value="2">Блок №2</option>
        </select>

        <!-- Вибір Фрагменту -->
        <select class="custom-select" id="select-fragment">
            <!-- Цей варіант буде видимим спочатку, але його не можна обрати повторно -->
            <option value="" disabled selected>Оберіть фрагмент...</option>

            <!-- Значення -->
            <option value="gvp.png">Живлення власних потреб</option>
            <option value="vru.png">Відкрита розподільча установка 330кВ, 750кВ</option>
            <option value="h00n.png">Другий контур</option>
            <option value="то.png">Турбіне відділення</option>
            <option value="ро.png">Реакторне відділення</option>
            <option value="ya00m.png">Петлі</option>
            <option value="пд_уд.png">Вузький діапазон</option>
            <option value="кфб_з.png">Охолодження активної зони</option>
        </select>

        <!-- Режим відображення -->
        <select class="custom-select" id="modeSelect">
            <option value="auto">Авто (Fit)</option>
            <option value="stretch">Розтягнути</option>
            <option value="original">Оригінальний</option>
        </select>

        <div class="info-blocks">
            <div class="data-info">
                <span id="clock">0000.00.00 00:00:00<span class="ms">.000</span></span>
                <span class="period-tag">10с</span>
            </div>
        </div>

        <button
            class="fullscreen-btn"
            id="toggleFullscreenSchema"
            title="На весь екран"
            onclick="toggleFullscreen()"
        >
            <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
                />
            </svg>
        </button>
    </header>

    <div class="schema-body" id="bodyShemaContainer">
        <div class="schema-scene" id="scene">
            <!-- LAYER 1: Background Grid -->
            <div class="layer layer-bg" id="layer-bg-fragment"></div>

            <!-- LAYER 2: SVG Connections -->
            <div class="layer layer-svg">
                <!-- <svg class="schema-svg-layer" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                                <path d="M 200 300 L 500 300 L 500 700 L 800 700" class="schema-line" />
                                <path d="M 500 300 L 800 300" class="schema-line" style="stroke: var(--success); opacity: 0.5;" />
                            </svg> -->
            </div>

            <!-- LAYER 3: Nodes -->
            <div class="layer layer-nodes">
                <div class="schema-node" style="left: 20%; top: 30%">
                    <span class="node-label">ВХІДНИЙ ТИСК</span>
                    <span class="node-value">12.4 Bar</span>

                    <!-- Розширена розмірка підказки -->
