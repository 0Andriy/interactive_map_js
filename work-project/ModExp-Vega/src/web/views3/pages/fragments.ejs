                                        <div class="popover-item"><span class="popover-key">Темп.</span><span class="popover-val">24.5°C</span></div>
                                        <div class="popover-item"><span class="popover-key">Потік</span><span class="popover-val">120 L/m</span></div>
                                        <div class="popover-item"><span class="popover-key">Навантаж.</span><span class="popover-val">68%</span></div>
                                    </div>
                                </div> -->
                </div>

                <div class="schema-node" style="left: 50%; top: 50%">
                    <span class="node-label">КОНТРОЛЕР</span>
                    <span class="node-value">NORMAL</span>
                </div>

                <div class="schema-node" style="left: 80%; top: 70%">
                    <span class="node-label">ТЕМПЕРАТУРА</span>
                    <span class="node-value">84.2 °C</span>

                    <!-- Розширена розмірка підказки -->
                    <!-- <div class="node-popover">
                                    <div class="popover-header">Детальна статистика</div>
                                    <div class="popover-grid">
                                        <div class="popover-item"><span class="popover-key">Тиск</span><span class="popover-val">0 Bar</span></div>
