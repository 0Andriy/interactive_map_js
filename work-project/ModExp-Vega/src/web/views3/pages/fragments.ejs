                                        <div class="popover-item"><span class="popover-key">Навантаж.</span><span class="popover-val">0%</span></div>
                                    </div>
                                </div> -->
                </div>

                <div class="schema-node" style="left: 80%; top: 30%">
                    <span class="node-label">РЕЗЕРВ</span>
                    <span class="node-value">0.0%</span>
                </div>
            </div>
        </div>
    </div>
