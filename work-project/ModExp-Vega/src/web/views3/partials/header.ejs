<%
// Імітація даних користувача (в реальності приходить через res.render)
const demoUser = locals.user || {
    name: 'Олександр Коваленко',
    login: 'alex_dev',
    email: 'a.kovalenko@smart-schema.io',
    avatar: null
};

// Генерація ініціалів
const initials = demoUser.name
    .split(' ')
    .filter(word => word.length > 0)
    .map(word => word.charAt(0))
    .join('')
    .toUpperCase()
    .substring(0, 2);
%>

<header class="main-header">
    <div class="header-container">

        <!-- Ліва частина: Логотип -->
        <div class="header-left">
            <a href="/" class="logo-link">
                <div class="logo-symbol">
                    <svg viewBox="0 0 24 24" class="logo-svg" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <span class="brand-name">Schema<span class="ms">Flow</span></span>
            </a>
        </div>

        <!-- Центральна частина -->
        <div class="header-center"></div>

        <!-- Права частина: Користувач -->
        <div class="header-right">
            <div class="user-dropdown-container">

                <div class="profile-info-trigger">
                    <div class="user-meta">
                        <span class="display-name"><%= demoUser.name %></span>
                        <span class="handle">@<%= demoUser.login %></span>
                    </div>
                    <div class="avatar-box">
                        <% if (demoUser.avatar) { %>
                            <img src="<%= demoUser.avatar %>" alt="Аватар">
                        <% } else { %>
                            <div class="avatar-initials"><%= initials %></div>
                        <% } %>
                        <span class="status-badge-online"></span>
                    </div>
                </div>

                <!-- Компактне випадаюче меню -->
                <div class="modern-dropdown">
                    <div class="dropdown-header-compact">
                        <span class="u-email-small"><%= demoUser.email %></span>
                    </div>

                    <nav class="dropdown-links">
                        <a href="/profile" class="d-link">
                            <div class="d-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <span>Профіль</span>
                        </a>

                        <a href="/settings" class="d-link">
                            <div class="d-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                            </div>
                            <span>Налаштування</span>
                        </a>

                        <div class="d-sep"></div>

                        <a href="/logout" class="d-link d-logout">
                            <div class="d-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </div>
                            <span>Вийти</span>
                        </a>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</header>
