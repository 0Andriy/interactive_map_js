<!DOCTYPE html>
<html lang="uk">
<head>
    <%- include('partials/head', {title: 'DevFlow - Головна'}) %>
</head>
<body>
    <div class="mobile-overlay" id="overlay"></div>

    <%- include('partials/navbar') %>
    <%- include('partials/sidebar-l') %>
    <%- include('partials/sidebar-r') %>

    <main class="main-wrapper">
        <h1 style="margin-bottom: 24px; font-weight: 800; letter-spacing: -1.5px;">Dashboard</h1>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
            <div style="background: var(--bg-glass); border: 1px solid var(--border); padding: 24px; border-radius: 20px; grid-column: span 2;">
                <h3 style="color:var(--accent)">Основна статистика</h3>
            </div>
            <div style="background: var(--bg-glass); border: 1px solid var(--border); padding: 24px; border-radius: 20px;">
                <p style="color:var(--text-muted)">Uptime</p>
                <h2 style="font-size: 2rem; color: #10b981; margin-top:10px;">99.9%</h2>
            </div>
        </div>
    </main>

    <script src="/js/main.js"></script>
</body>
</html>
