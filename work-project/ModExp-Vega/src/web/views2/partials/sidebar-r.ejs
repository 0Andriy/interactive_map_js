<aside class="sidebar sidebar-right hidden" id="rightSide">
    <button class="floating-toggle r-toggle" id="rightToggle">
        <svg
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
        >
            <path d="M9 5l7 7-7 7"></path>
        </svg>
    </button>
    <div style="padding: 24px; min-width: 280px">
        <p
            style="
                font-size: 0.75rem;
                text-transform: uppercase;
                color: var(--text-muted);
                letter-spacing: 1px;
                margin-bottom: 20px;
            "
        >
            Інструментарій
        </p>
        <div
            style="
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--border);
                padding: 20px;
                border-radius: 16px;
            "
        >
            <h4 style="font-size: 0.9rem">Деплой</h4>
            <button
                style="
                    width: 100%;
                    margin-top: 12px;
                    padding: 10px;
                    background: var(--accent);
                    border: none;
                    border-radius: 8px;
                    font-weight: 700;
                    cursor: pointer;
                "
            >
                Запустити
            </button>
        </div>
    </div>
</aside>
