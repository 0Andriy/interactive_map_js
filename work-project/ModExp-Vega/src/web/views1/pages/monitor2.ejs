<div id="monitor-wrapper" class="monitor-container">
    <!-- Шапка з керуванням -->
    <div class="monitor-header">
        <div class="header-controls">
            <div class="control-group">
                <label>Об'єкт:</label>
                <select id="select-unit" class="m-select">
                    <option value="1">Вузол #1</option>
                    <option value="2">Вузол #2</option>
                    <option value="3">Вузол #3</option>
                </select>
            </div>
            <div class="control-group">
                <label>Схема:</label>
                <select id="select-file" class="m-select">
                    <option value="gvp.png">Живлення власних потреб</option>
                    <!-- <option value="boiler.png">Котельня</option> -->
                    <!-- <option value="pumps.png">Насосна станція</option> -->
                </select>
            </div>
            <div class="status-group">
                <span class="pulse-status"></span>
                <small id="update-time">Очікування...</small>
            </div>
        </div>
        <div class="header-actions">
            <button id="fs-toggle" class="btn-fullscreen" title="Повний екран">⛶</button>
        </div>
    </div>

    <!-- Область візуалізації -->
    <div class="monitor-viewport">
        <div id="canvas-area" class="canvas-area">
            <!-- Фон -->
            <img id="bg-layer" src="" class="bg-layer" alt="Завантаження..." />

            <!-- SVG для зв'язків -->
            <svg id="svg-layer" class="svg-layer" preserveAspectRatio="none"></svg>

            <!-- Динамічні датчики -->
            <div id="dynamic-layer" class="dynamic-layer"></div>
        </div>
    </div>
</div>

<!-- Підключення специфічних стилів -->
<link rel="stylesheet" href="/css/monitor.css" />
<script type="module" src="/js/pages/monitor.js"></script>
