<div id="monitor-wrapper" class="monitor-container">
    <!-- Шапка контейнера -->
    <div class="monitor-header">
        <div class="header-left">
            <span class="monitor-title"
                >📊 Моніторинг об'єкта: <b id="unit-id"><%= unitId %></b></span
            >
            <span class="last-update">Оновлено: <i id="update-time">--:--:--</i></span>
        </div>
        <div class="header-right">
            <button id="fullscreen-btn" class="btn-icon">⛶ Повний екран</button>
        </div>
    </div>

    <!-- Робоча область -->
    <div class="monitor-viewport">
        <div class="map-layer" id="map-layer">
            <!-- Фонова картинка -->
            <img
                src="/api/v1/ios/fragment/png/<%= unitId %>?fileName=<%= fileName %>"
                class="bg-image"
                id="bg-image"
            />

            <!-- Шар для ліній (SVG) -->
            <svg
                class="svg-layer"
                id="svg-layer"
                viewBox="0 0 1000 1000"
                preserveAspectRatio="none"
            >
                <line
                    x1="20%"
                    y1="30%"
                    x2="50%"
                    y2="50%"
                    stroke="rgba(59, 130, 246, 0.5)"
                    stroke-width="2"
                />
            </svg>

            <!-- Динамічні датчики (приклади) -->
            <div class="sensor-point" style="top: 30%; left: 20%" data-param="temp">
                <span class="sensor-value" id="val-temp">--</span>
                <span class="sensor-label">Температура</span>
            </div>

            <div class="sensor-point" style="top: 50%; left: 50%" data-param="press">
                <span class="sensor-value" id="val-press">--</span>
                <span class="sensor-label">Тиск</span>
            </div>
        </div>
    </div>
</div>

<script type="module" src="/js/pages/monitor.js"></script>
