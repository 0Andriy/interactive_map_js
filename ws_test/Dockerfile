# =====================================================================
# ЕТАП 1: Підготовка та ізоляція залежностей (Builder)
# =====================================================================
# Використовуємо легку версію Node.js на базі ОС Alpine Linux.
# "AS builder" означає, що цей етап тимчасовий і потрібен лише для підготовки файлів.
FROM node:22-alpine AS builder

# Створюємо робочу папку всередині контейнера, де будуть лежати файли проєкту
WORKDIR /app

# Копіюємо package.json та package-lock.json.
# Робимо це ОКРЕМО від іншого коду, щоб Docker міг закешувати цей крок.
# Якщо код змінився, але нові бібліотеки не додавалися — Docker не буде качати їх заново.
COPY package*.json ./

# Встановлюємо абсолютно ВСІ залежності (і devDependencies, і продакшен).
# "--mount=type=cache..." використовує кеш вашого комп'ютера, щоб повторні збірки йшли миттєво.
# "npm ci" — це команда для чистого встановлення (швидша та суворіша за "npm install").
RUN --mount=type=cache,target=/root/.npm npm ci

# Копіюємо всі інші файли проєкту (весь ваш JavaScript код, тощо)
COPY . .

# ТИМЧАСОВО ДЛЯ JS: Оскільки зараз збірщика немає, ми просто імітуємо папку dist.
# Коли ви перейдете на TypeScript, ви видалите рядок "mkdir dist && cp..."
# і розкоментуєте команду "RUN npm run build".
RUN mkdir dist && cp -r *.js ./dist 2>/dev/null || cp *.json ./dist
# RUN npm run build  # <- розкоментуйте це, коли перейдете на TypeScript!

# Видаляємо з папки node_modules всі devDependencies (наприклад, лінтери чи тестові утиліти).
# Залишаються тільки робочі бібліотеки (Express, Swagger тощо), щоб образ важив менше.
RUN npm prune --production



# =====================================================================
# ЕТАП 2: Фінальний образ для запуску (Runtime)
# =====================================================================
# Починаємо з чистого аркуша. Все, що було на першому етапі (крім скопійованого), видаляється.
FROM node:22-alpine AS runtime

# Задаємо робочу директорію для фінального контейнера
WORKDIR /app

# Копіюємо з першого етапу (builder) ТІЛЬКИ те, що реально потрібно для роботи додатка:
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Копіюємо ПОВНІСТЮ всю очищену робочу директорію з першого етапу.
# Завдяки цьому зберігається вся структура вкладених папок (src, routes, utils тощо).
COPY --from=builder /app ./

# Створюємо папку для логів всередині контейнера (якщо її ще немає в проєкті)
RUN mkdir -p logs

# З міркувань безпеки змінюємо власника файлів у папці /app на вбудованого користувача "node".
# За замовчуванням Docker запускає все від імені "root", що небезпечно, якщо додаток зламають.
RUN chown -R node:node /app

# Перемикаємося з суперкористувача (root) на звичайного користувача "node"
USER node

# Документуємо, що наш Express додаток всередині контейнера слухає 3000 порт
EXPOSE 3000

# Запускаємо сервер НАПРЯМУ через node (без npm).
# Використовуємо обов'язково ПОДВІЙНІ лапки, бо Docker приймає тільки такий формат JSON-масиву.
CMD ["node", "dist/app.js"]
